#!/bin/sh
# Pre-commit guard for EditIt Web
#
# Prevents committing with a real name/email. The published history must use
# the placeholder identity (Agent <agent@pi.dev>) so no personal data leaks
# to GitHub. If a commit's author or committer email is not the allowed value,
# the commit is aborted.
#
# Setup (run once per clone):
#   git config core.hooksPath .githooks
#
# The placeholder identity is supplied via GIT_AUTHOR_* / GIT_COMMITTER_*
# environment variables (see AGENTS.md). This hook is a safety net in case
# those are missing and git falls back to a real global identity.

ALLOWED_AUTHOR="agent@pi.dev"
ALLOWED_COMMITTER="agent@pi.dev"

author_email=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed -E 's/.*<([^>]+)>.*/\1/')
committer_email=$(git var GIT_COMMITTER_IDENT 2>/dev/null | sed -E 's/.*<([^>]+)>.*/\1/')

if [ "$author_email" != "$ALLOWED_AUTHOR" ]; then
    echo "ERROR: Commit author email '$author_email' is not allowed." >&2
    echo "       Expected '$ALLOWED_AUTHOR'." >&2
    echo "       Set GIT_AUTHOR_EMAIL / git config user.email to the placeholder." >&2
    exit 1
fi

if [ "$committer_email" != "$ALLOWED_COMMITTER" ]; then
    echo "ERROR: Commit committer email '$committer_email' is not allowed." >&2
    echo "       Expected '$ALLOWED_COMMITTER'." >&2
    echo "       Set GIT_COMMITTER_EMAIL / git config user.email to the placeholder." >&2
    exit 1
fi

exit 0
